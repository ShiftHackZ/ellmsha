# Copy to .env. Keep .env private: it contains provider credentials.
# Wiki synthesis and conversation extraction follow the originating chat model.
AION_LLM_REQUIRE_CONTEXT=1
AION_LLM_CALLBACK_ALLOWED_HOSTS=host.docker.internal,localhost,127.0.0.1,[::1],aionui

# Legacy standalone/proxy configuration, used when follow-chat mode is disabled.
# These values do not select the model of an agent-originating generation job.
MEMORY_LLM_BASE_URL=http://host.docker.internal:11434/v1
MEMORY_LLM_API_KEY=ollama
MEMORY_LLM_MODEL=REPLACE_ME
MEMORY_LLM_PROTOCOL=openai

# Stable search encoder, independent of the chat/generation model.
# Changing its provider/model/dimensions rebuilds vectors; switching chats does not.
# Multilingual semantic recall, entirely local. Run `ollama pull bge-m3` first.
# Set provider=none for keyword-only search (no cross-language recall).
MEMORY_EMBEDDING_PROVIDER=openai_compatible
MEMORY_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
MEMORY_EMBEDDING_API_KEY=ollama
MEMORY_EMBEDDING_MODEL=bge-m3
MEMORY_EMBEDDING_DIMENSIONS=1024

# One upstream for this pilot's TencentDB proxy. This can differ from the
# extraction model above. AionUi can use other providers without this proxy.
PROXY_UPSTREAM_URL=http://host.docker.internal:11434/v1
PROXY_UPSTREAM_API_KEY=ollama
PROXY_UPSTREAM_MODEL=REPLACE_ME
PROXY_FULL_STACK=1
TDAI_BIND_HOST=127.0.0.1

# Build the modified fork: docker build -t ellmsha-memory-core:local tencentdb-agent-memory/MemoryCore
MEMORY_CORE_IMAGE=ellmsha-memory-core:local
MEMORY_HUB_IMAGE=ellmsha-memory-hub:local
PROXY_IMAGE=agentmemory/memory-proxy:latest
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096
MEMORY_CORE_VOLUME=ellmsha-v3-memory-core
PANEL_VOLUME=ellmsha-v3-memory-panel
MEMORY_CORE_GATEWAY_API_KEY=
MEMORY_CORE_ADMIN_USERNAME=admin
MEMORY_PROMPT_MODE=code
KNOWLEDGE_PUBLIC_BASE_URL=http://host.docker.internal:8424/v3
MEMORY_HUB_PROXY_PUBLIC_URL=http://127.0.0.1:8096

# AionUi WebUI. Set V3_WORKSPACES_DIR to a host directory containing only
# projects you want the containerized agent to access.
AIONUI_PORT=3000
V3_WORKSPACES_DIR=./workspaces
AIONUI_TAG=v2.1.47-final
AIONUI_VERSION=2.1.47

# Optional readonly local Git workspace for Tencent CodeGraph snapshots.
KNOWLEDGE_LOCAL_SOURCE_ROOT=
KNOWLEDGE_LOCAL_MOUNT_ROOT=/workspaces/ellmsha-v3
